{
  "project": "campus-energy-stgcn",
  "version": "1.3.0",
  "author": "林晓",
  "model": {
    "name": "STGNN",
    "layers_graph": 2,
    "layers_tcn": 4,
    "dilations": [
      1,
      2,
      4,
      8
    ],
    "attention_heads": 4,
    "hidden_dim": 128,
    "input_window_hours": 168,
    "output_window_hours": 24,
    "loss": {
      "type": "huber",
      "delta": 1.0,
      "peak_weight": 0.3
    },
    "optimizer": {
      "type": "AdamW",
      "lr": 0.001,
      "weight_decay": 0.0001
    },
    "batch_size": 64,
    "epochs": 80,
    "early_stop_patience": 10
  },
  "distillation": {
    "teacher": "STGNN",
    "student_params_m": 0.42,
    "temperature": 3.0,
    "alpha": 0.6
  },
  "deployment": {
    "edge_device": "Jetson Orin Nano 8GB",
    "runtime": "TensorRT 8.6",
    "quantization": "INT8-static",
    "latency_ms": 23,
    "covered_buildings": 8,
    "gateway_service": "FastAPI + MQTT"
  },
  "dataset": {
    "buildings": 12,
    "range": [
      "2024-09-01",
      "2025-06-30"
    ],
    "raw_records": 3400000,
    "valid_samples": 263000,
    "frequency_minutes": 15
  },
  "metrics": {
    "MAE": 0.183,
    "RMSE": 0.267,
    "MAPE": 8.7
  },
  "pilot": {
    "start": "2025-05-12",
    "end": "2025-06-20",
    "peak_reduction": 0.116,
    "annual_saving_cny": 187000
  }
}